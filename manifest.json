{
    "manifest_version": 3,
    "name": "InstaNeverPause",
       "author": "LaneZeroX@proton.me",
    "version": "1.0.0",
      "short_name": "INP",
    "description": "Keep Instagram videos playing without interruptions when switching tabs. Never miss a moment!",
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "*://*.instagram.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "InstaNeverPause - Keep Videos Playing",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
"content_scripts": [
    {
        "matches": ["*://*.instagram.com/*"],
        "js": ["page-guard.js"],
        "run_at": "document_start",
        "world": "MAIN"
    },
    {
        "matches": ["*://*.instagram.com/*"],
        "js": ["content.js"],
        "run_at": "document_start",
        "world": "ISOLATED"
    }
],
    "background": {
        "service_worker": "background.js"
    },
    "web_accessible_resources": [
        {
            "resources": ["icons/*.png"],
            "matches": ["*://*.instagram.com/*"]
        }
    ]
}